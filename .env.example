# Create a HubSpot private app and keep its access token server-side.
HUBSPOT_ACCESS_TOKEN=

# Required for the newsletter form. Find the numeric ID in HubSpot's
# communication subscription settings or through the definitions API.
HUBSPOT_NEWSLETTER_SUBSCRIPTION_ID=

# Optional: when both values are present, every quote request also creates a
# deal associated with the contact. Use HubSpot's internal IDs, not labels.
HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=

# Optional: assign newly created contacts, notes, and deals to this owner.
HUBSPOT_OWNER_ID=
